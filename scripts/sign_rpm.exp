#!/usr/bin/expect -f

# Get the RPM file and passphrase from arguments or environment variables
set rpm_file [lindex $argv 0]
set passphrase $env(GPG_PASSPHRASE)
set timeout 20

# Spawn the rpmsign command
spawn rpmsign --addsign $rpm_file

# Expect the passphrase prompt and send the passphrase
expect "Enter pass*"
send "$passphrase\r"

# Wait for the command to finish
expect eof